{
  "name": "compro-tmp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/run.ts",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "codegen": "tsx scripts/generate-contract.ts",
    "codegen:check": "tsx scripts/generate-contract.ts --check",
    "audit:types": "type-coverage --at-least 95",
    "audit:imports": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src",
    "audit:unused": "knip --no-progress",
    "audit:duplicates": "jscpd src --threshold 3 --reporters console",
    "test:seed": "tsx scripts/seed-e2e.ts",
    "audit:lighthouse": "lhci autorun",
    "audit:bundle": "node --import tsx scripts/check-bundle.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/postcss": "^4.3.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "jose": "^6.2.15",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "prisma": "^7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jscpd": "^5.4.3",
    "jsdom": "^31.0.1",
    "knip": "^6.46.1",
    "madge": "^8.0.0",
    "msw": "^3.0.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "type-coverage": "^2.31.2",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "22.23.4"
  }
}
