# Copy to .env and supply real local values. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/compro"
# Generate with: openssl rand -base64 48
AUTH_SECRET=""
# Required only by prisma/seed.ts; no default administrator credentials.
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="compro-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"
# Optional public read origin for published media; never enable bucket writes.
S3_PUBLIC_URL=""
# NODE_ENV is set automatically by Next.js (development/test/production).
